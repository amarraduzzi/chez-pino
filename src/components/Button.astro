---
interface Props {
  href: string;
  external?: boolean;
  variant?: 'outline' | 'filled' | 'cta';
  class?: string;
}
const { href, external = false, variant = 'outline', class: className = '' } = Astro.props;
const variantClass = variant === 'outline' ? 'amp-btn-outline' : variant === 'cta' ? 'amp-btn-cta amp-btn-outline' : 'amp-btn-filled';
---
<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
  data-magnetic={variant === 'cta' ? 'true' : undefined}
  class:list={[
    'amp-btn relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-lg px-6 py-3.5 text-sm font-bold tracking-wide transition-colors duration-200',
    variantClass,
    className,
  ]}
>
  <span class="relative z-10 inline-flex items-center gap-2">
    <slot />
    {variant === 'cta' && (
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="amp-btn-arrow">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
  </span>
</a>

<style>
  .amp-btn-outline {
    border: 1.5px solid var(--color-primary);
    color: var(--color-primary);
    background-color: transparent;
  }
  .amp-btn-outline::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }
  .amp-btn-outline:hover::before,
  .amp-btn-outline:active::before {
    transform: scaleX(1);
  }
  .amp-btn-outline:hover,
  .amp-btn-outline:active {
    color: var(--color-background);
  }
  .amp-btn-filled {
    background-color: var(--color-primary);
    color: var(--color-background);
  }
  .amp-btn-filled:hover {
    filter: brightness(1.08);
  }
  .amp-btn-cta {
    padding-left: 1.75rem;
    padding-right: 1.75rem;
    transition: transform 0.15s ease-out, color 0.2s ease;
  }
  .amp-btn-arrow {
    transition: transform 0.2s ease;
  }
  .amp-btn-cta:hover .amp-btn-arrow {
    transform: translateX(3px);
  }
  [dir='rtl'] .amp-btn-arrow {
    transform: scaleX(-1);
  }
  [dir='rtl'] .amp-btn-cta:hover .amp-btn-arrow {
    transform: scaleX(-1) translateX(3px);
  }
</style>
