---
// Real Chez Pino logo (yellow mark on transparent background,
// public/brand/logo-pino.png). Header is deliberately compact — height and
// logo size are driven by CSS (not Tailwind h-* utilities) so the whole bar
// can shrink smoothly once the page scrolls (see #site-header[data-scrolled]
// below), instead of staying the same tall size forever.
// Mobile language switcher is a compact dropdown (button + chevron) grouped
// with the hamburger toggle so both sit adjacent on the right edge; the
// 3-way pill row is kept for sm+ screens where there's room for it.
// Below lg, the full nav is hidden, which left a bare gap next to the logo —
// filled with a small live "Ouvert / Fermé" status chip (see
// OpenStatusBadge's compact prop) instead of leaving it empty.
import { siteConfig } from '../config/site.config';
import { getReserveCtaLabel } from '../lib/nav';
import { LANGUAGES, LANGUAGE_LABEL, LANGUAGE_NATIVE_NAME, localizedPath, arrow, t, type Language } from '../i18n/languages';
import { nav as navUi } from '../i18n/ui';
import OpenStatusBadge from './OpenStatusBadge.astro';

interface Props {
  lang?: Language;
  minimal?: boolean;
}
const { lang = 'fr', minimal = false } = Astro.props;
const reserveCta = getReserveCtaLabel(lang);

const nav = [
  { href: '/', label: t(navUi.accueil, lang) },
  { href: '/menu', label: t(navUi.menu, lang) },
  { href: '/carte', label: t(navUi.carte, lang) },
  { href: '/a-propos', label: t(navUi.aPropos, lang) },
  { href: '/avis', label: t(navUi.avis, lang) },
  { href: '/club', label: t(navUi.club, lang) },
  { href: '/faq', label: t(navUi.faq, lang) },
  { href: '/contact', label: t(navUi.contact, lang) },
].map((item) => ({ ...item, href: localizedPath(item.href, lang) }));

const currentPath = Astro.url.pathname;
const langLinks = LANGUAGES.map((l) => ({ lang: l, href: localizedPath(currentPath, l) }));
---
<header id="site-header" class="sticky top-0 z-40 transition-all duration-300" data-scrolled="false">
  <div class="site-header-inner max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-3 sm:gap-4">
    <a href={localizedPath('/', lang)} class="flex items-center gap-2 min-w-0 shrink">
      <img
        src="/brand/logo-pino.png"
        alt={siteConfig.identity.name}
        class="site-logo-img w-auto"
        width="360"
        height="360"
        decoding="async"
      />
    </a>

    {!minimal && (
      <div class="header-status flex lg:hidden items-center pl-3 ml-0.5 shrink-0" style="border-left: 1px solid var(--color-border)">
        <OpenStatusBadge lang={lang} compact />
      </div>
    )}

    {!minimal && (
      <nav class="hidden lg:flex items-center gap-5 shrink-0">
        {nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-semibold transition-colors"
            style={`color: ${currentPath === item.href ? 'var(--color-primary)' : 'var(--color-text-primary)'}`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    )}

    <!-- Desktop / tablet: full 3-way pill switcher -->
    <div class="hidden sm:flex items-center gap-0.5 sm:gap-1 shrink-0 rounded-full p-0.5" style="border: 1px solid var(--color-border)">
      {langLinks.map((l) => (
        <a
          href={l.href}
          aria-label={LANGUAGE_NATIVE_NAME[l.lang]}
          aria-current={lang === l.lang ? 'true' : undefined}
          class="px-1.5 sm:px-2 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-colors"
          style={`color: ${lang === l.lang ? 'var(--color-background)' : 'var(--color-text-muted)'}; background-color: ${lang === l.lang ? 'var(--color-primary)' : 'transparent'}`}
        >
          {LANGUAGE_LABEL[l.lang]}
        </a>
      ))}
    </div>

    {!minimal && (
      <a
        href={reserveCta.href}
        class="hidden sm:inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold px-4 sm:px-5 py-2 sm:py-2.5 rounded-full shrink-0 transition-transform duration-200 hover:scale-[1.04]"
        style="background-color: var(--color-primary); color: var(--color-background)"
      >
        {reserveCta.label} {arrow(lang)}
      </a>
    )}

    <!-- Mobile-only cluster: language dropdown + hamburger grouped together
         so they sit side by side, pinned to the right edge as one unit
         (kept separate they'd be spread apart by justify-between). -->
    <div class="flex items-center gap-2 shrink-0">
      <div class="relative sm:hidden" id="lang-dropdown">
        <button
          type="button"
          id="lang-dropdown-toggle"
          aria-haspopup="true"
          aria-expanded="false"
          class="flex items-center gap-1 pl-2.5 pr-2 py-1.5 rounded-full text-[11px] font-bold"
          style="border: 1px solid var(--color-border); color: var(--color-text-primary)"
        >
          <span id="lang-dropdown-current">{LANGUAGE_LABEL[lang]}</span>
          <svg id="lang-dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-200">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div
          id="lang-dropdown-menu"
          class="hidden absolute right-0 top-full mt-2 rounded-xl overflow-hidden z-50"
          style="background-color: var(--color-surface); border: 1px solid var(--color-border); box-shadow: 0 12px 28px rgba(0,0,0,0.5); min-width: 84px"
        >
          {langLinks.map((l) => (
            <a
              href={l.href}
              aria-label={LANGUAGE_NATIVE_NAME[l.lang]}
              aria-current={lang === l.lang ? 'true' : undefined}
              class="block px-4 py-2.5 text-xs font-bold transition-colors"
              style={`color: ${lang === l.lang ? 'var(--color-primary)' : 'var(--color-text-primary)'}`}
            >
              {LANGUAGE_LABEL[l.lang]}
            </a>
          ))}
        </div>
      </div>

      {!minimal && (
        <button id="mobile-nav-toggle" class="lg:hidden shrink-0" aria-label="Menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--color-text-primary)">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
        </button>
      )}
    </div>
  </div>

  {!minimal && (
    <div id="mobile-nav-panel" class="lg:hidden hidden flex-col px-4 pb-4" style="background-color: var(--color-surface)">
      {nav.map((item) => (
        <a href={item.href} class="py-2.5 text-sm font-semibold" style="color: var(--color-text-primary)">
          {item.label}
        </a>
      ))}
      <a
        href={reserveCta.href}
        class="mt-3 pt-3 py-2.5 text-sm font-bold"
        style="border-top: 1px solid var(--color-border); color: var(--color-primary)"
      >
        {reserveCta.label} {arrow(lang)}
      </a>
    </div>
  )}

  <div class="h-px w-full transition-colors duration-300" id="header-track">
    <div id="header-progress" class="h-full" style="width: 0%; background-color: var(--color-primary)"></div>
  </div>
</header>

<style>
  #site-header {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  #site-header[data-scrolled='true'] {
    background-color: color-mix(in srgb, var(--color-surface) 95%, transparent);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  #header-track {
    background-color: transparent;
  }
  #site-header[data-scrolled='true'] #header-track {
    background-color: var(--color-border);
  }
  #mobile-nav-panel.open {
    display: flex;
  }
  #lang-dropdown-menu.open {
    display: block;
  }
  #lang-dropdown-chevron.open {
    transform: rotate(180deg);
  }

  /* Compact by default, shrinks further once scrolled — height and logo
     size are plain CSS (not Tailwind h-* utilities) precisely so this
     smooth transition can happen without fighting utility-class specificity. */
  .site-header-inner {
    height: 72px;
    transition: height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site-logo-img {
    height: 42px;
    transition: height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 640px) {
    .site-header-inner { height: 88px; }
    .site-logo-img { height: 54px; }
  }
  #site-header[data-scrolled='true'] .site-header-inner {
    height: 58px;
  }
  #site-header[data-scrolled='true'] .site-logo-img {
    height: 32px;
  }
  @media (min-width: 640px) {
    #site-header[data-scrolled='true'] .site-header-inner { height: 68px; }
    #site-header[data-scrolled='true'] .site-logo-img { height: 40px; }
  }
</style>

<script>
  let scrollHandler: (() => void) | null = null;
  let outsideClickHandler: ((e: MouseEvent) => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('site-header');
    const progress = document.getElementById('header-progress');
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    const langWrap = document.getElementById('lang-dropdown');
    const langToggle = document.getElementById('lang-dropdown-toggle');
    const langMenu = document.getElementById('lang-dropdown-menu');
    const langChevron = document.getElementById('lang-dropdown-chevron');

    function onScroll() {
      if (!header || !progress) return;
      const scrolled = window.scrollY > 8;
      header.dataset.scrolled = String(scrolled);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      progress.style.width = `${pct * 100}%`;
    }
    onScroll();

    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);
    scrollHandler = onScroll;
    window.addEventListener('scroll', scrollHandler, { passive: true });

    toggle?.addEventListener('click', () => {
      const isOpen = panel?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    });

    function closeLangMenu() {
      langMenu?.classList.remove('open');
      langChevron?.classList.remove('open');
      langToggle?.setAttribute('aria-expanded', 'false');
    }

    langToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = langMenu?.classList.toggle('open');
      langChevron?.classList.toggle('open', Boolean(isOpen));
      langToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    });

    if (outsideClickHandler) document.removeEventListener('click', outsideClickHandler);
    outsideClickHandler = (e: MouseEvent) => {
      if (langWrap && !langWrap.contains(e.target as Node)) closeLangMenu();
    };
    document.addEventListener('click', outsideClickHandler);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLangMenu();
    });
  });
</script>
