---
import { siteConfig } from '../config/site.config';
import { getReserveCtaLabel } from '../lib/nav';
import { localizedPath, t, type Language } from '../i18n/languages';
import { nav as navUi, common, footer as footerUi } from '../i18n/ui';
import Button from './Button.astro';
import OpenStatusBadge from './OpenStatusBadge.astro';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;
const reserveCta = getReserveCtaLabel(lang);

const nav = [
  { href: '/', label: t(navUi.accueil, lang), emphasis: false },
  { href: '/menu', label: t(navUi.menu, lang), emphasis: false },
  { href: '/carte', label: t(navUi.carte, lang), emphasis: true },
  { href: '/a-propos', label: t(navUi.aPropos, lang), emphasis: false },
  { href: '/avis', label: t(navUi.avis, lang), emphasis: true },
  { href: '/club', label: t(navUi.club, lang), emphasis: false },
  { href: '/reservation', label: t(navUi.reservation, lang), emphasis: true },
  { href: '/faq', label: t(navUi.faq, lang), emphasis: false },
  { href: '/contact', label: t(navUi.contact, lang), emphasis: false },
].map((item) => ({ ...item, href: localizedPath(item.href, lang) }));

const ratingRounded = siteConfig.social.googleRating ? Math.round(Number(siteConfig.social.googleRating)) : 0;
const ratingStars = '★'.repeat(ratingRounded) + '☆'.repeat(5 - ratingRounded);
---
<footer class="relative overflow-hidden" style="background-color: var(--color-surface); border-top: 1px solid var(--color-border)">
  <div class="section-glow" style="width: 320px; height: 320px; background: var(--color-primary); opacity: 0.06; left: -110px; bottom: -110px;"></div>

  <div class="relative max-w-7xl mx-auto px-5 sm:px-8 py-14 grid sm:grid-cols-3 gap-10">
    <div>
      <div>
        <span class="text-[11px] font-bold uppercase tracking-[0.2em]" style="color: var(--color-accent)">
          {siteConfig.identity.city}
        </span>
        <h3 class="font-display text-2xl font-semibold" style="color: var(--color-primary)">
          {siteConfig.identity.name}
        </h3>
      </div>
      <p class="text-sm mt-3 max-w-xs" style="color: var(--color-text-muted)">
        {t(siteConfig.identity.tagline, lang)}
      </p>
      {siteConfig.social.googleRating && (
        <p class="mt-3 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs font-bold" style="color: var(--color-primary)">
          <span style="letter-spacing: 1px">{ratingStars}</span>
          <span style="color: var(--color-text-muted)">
            {siteConfig.social.googleRating}/5
            {siteConfig.social.googleReviewCount && ` · ${siteConfig.social.googleReviewCount} ${t(common.avisGoogle, lang)}`}
          </span>
          {siteConfig.social.googleReviewsUrl && (
            <a href={siteConfig.social.googleReviewsUrl} target="_blank" rel="noreferrer" class="hover:underline" style="color: var(--color-text-muted)">
              · {t(common.voirSurGoogle, lang)}
            </a>
          )}
        </p>
      )}
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <Button href={reserveCta.href}>{reserveCta.label}</Button>
        <!-- No verified Instagram/Facebook link exists for Chez Pino yet —
             deliberately omitted rather than fabricated. Once
             siteConfig.contact.instagramUrl / facebookUrl are filled in,
             icons render here automatically (see the guards below). -->
        {siteConfig.contact.instagramUrl && (
          <a
            href={siteConfig.contact.instagramUrl}
            target="_blank"
            rel="noreferrer"
            aria-label={`${siteConfig.identity.name} Instagram`}
            class="footer-social inline-flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full transition-all duration-200"
            style="border: 1.5px solid var(--color-border); color: var(--color-text-muted)"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" />
            </svg>
          </a>
        )}
        {siteConfig.contact.facebookUrl && (
          <a
            href={siteConfig.contact.facebookUrl}
            target="_blank"
            rel="noreferrer"
            aria-label={`${siteConfig.identity.name} Facebook`}
            class="footer-social inline-flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full transition-all duration-200"
            style="border: 1.5px solid var(--color-border); color: var(--color-text-muted)"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M15 8.5h-2c-.55 0-1 .45-1 1V12h3l-.4 3H12v7h-3v-7H7v-3h2V9.2C9 6.9 10.4 5.5 12.5 5.5H15v3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <div class="space-y-3 text-sm" style="color: var(--color-text-muted)">
      <p>{siteConfig.contact.address}</p>
      <p><a href={siteConfig.contact.phoneHref} class="hover:underline">{siteConfig.contact.phoneDisplay}</a></p>
      <p>{t(siteConfig.contact.openingHours, lang)}</p>
      <OpenStatusBadge lang={lang} />
    </div>

    <nav class="flex flex-col gap-2.5 sm:items-end text-sm">
      {nav.map((item) => (
        <a
          href={item.href}
          style={`color: ${item.emphasis ? 'var(--color-primary)' : 'var(--color-text-muted)'}`}
          class={`hover:underline ${item.emphasis ? 'font-bold' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <div class="relative flex justify-center pb-6 sm:pb-8">
    <svg class="footer-divider" width="120" height="20" viewBox="0 0 120 20" fill="none" aria-hidden="true">
      <path d="M2 10h34" stroke="var(--color-accent)" stroke-width="1" stroke-linecap="round" />
      <path d="M84 10h34" stroke="var(--color-accent)" stroke-width="1" stroke-linecap="round" />
      <g stroke="var(--color-primary)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M46 4v6a2 2 0 002 2h0" />
        <path d="M46 4v12" />
        <path d="M49 4v6" />
        <path d="M60 16c0-6 3-8 3-12v0" />
        <path d="M60 16V8" />
        <path d="M69 4c-1.5 0-2.5 1.4-2.5 3v3l2.5 1.5v4.5" />
      </g>
    </svg>
  </div>

  <div class="relative" style="border-top: 1px solid var(--color-border)">
    <p class="text-center text-[11px] py-4" style="color: var(--color-text-muted)">
      {siteConfig.identity.name} · {new Date().getFullYear()} · {t(footerUi.builtBy, lang)} ·{' '}
      <a href={localizedPath('/confidentialite', lang)} class="hover:underline">{t(footerUi.confidentialite, lang)}</a>
    </p>
  </div>
</footer>

<style>
  .footer-social:hover,
  .footer-social:focus-visible {
    color: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-primary) 14%, transparent);
    transform: translateY(-2px);
  }
</style>
