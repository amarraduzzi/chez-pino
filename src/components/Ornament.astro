---
// A small centered divider glyph — a simplified fork/leaf motif used
// between sections so a transition sometimes gets a quiet decorative beat
// instead of always being a flat color change.
---
<div class="flex items-center justify-center py-2" aria-hidden="true">
  <span class="h-px w-10 sm:w-16" style="background: linear-gradient(90deg, transparent, var(--color-border))"></span>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="mx-4 shrink-0" style="color: var(--color-primary)">
    <path d="M8 3v7a2 2 0 002 2v9M8 3v6M11 3v6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M16 3c1.5 2 1.5 5 0 7v11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="h-px w-10 sm:w-16" style="background: linear-gradient(90deg, var(--color-border), transparent)"></span>
</div>
