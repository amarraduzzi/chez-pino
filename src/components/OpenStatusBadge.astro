---
// Live "open now / closed" badge — computed client-side from the
// restaurant's real local time (Africa/Casablanca), not the visitor's own
// timezone/clock.
import { siteConfig } from '../config/site.config';
import { t, type Language } from '../i18n/languages';
import { common } from '../i18n/ui';

interface Props {
  lang?: Language;
  // Short "Ouvert" / "Fermé" instead of "Ouvert maintenant" — used in the
  // header where space next to the logo is tight.
  compact?: boolean;
}
const { lang = 'fr', compact = false } = Astro.props;
const { open, close } = siteConfig.contact.hours;
const shortLabel = { fr: ['Ouvert', 'Fermé'], en: ['Open', 'Closed'], ar: ['مفتوح', 'مغلق'] } as const;
const [shortOpen, shortClosed] = shortLabel[lang] ?? shortLabel.fr;
const labelOpen = compact ? shortOpen : t(common.ouvertMaintenant, lang);
const labelClosed = compact ? shortClosed : t(common.fermeMaintenant, lang);
---
<span
  class="open-status-badge inline-flex items-center gap-1.5"
  data-open-hour={open}
  data-close-hour={close}
  data-label-open={labelOpen}
  data-label-closed={labelClosed}
>
</span>

<style>
  .open-status-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .open-status-badge .dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .open-status-badge[data-state='open'] .dot {
    background-color: #3fbf60;
    box-shadow: 0 0 0 3px color-mix(in srgb, #3fbf60 25%, transparent);
  }
  .open-status-badge[data-state='closed'] .dot {
    background-color: var(--color-text-muted);
  }
  .open-status-badge[data-state='open'] {
    color: #3fbf60;
  }
  .open-status-badge[data-state='closed'] {
    color: var(--color-text-muted);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.open-status-badge').forEach((badge) => {
      const openHour = Number(badge.getAttribute('data-open-hour'));
      const closeHour = Number(badge.getAttribute('data-close-hour'));
      if (Number.isNaN(openHour) || Number.isNaN(closeHour)) return;

      const hourInCasablanca = Number(
        new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Casablanca', hour: 'numeric', hour12: false }).format(
          new Date()
        )
      );
      const isOpen = hourInCasablanca >= openHour && hourInCasablanca < closeHour;

      badge.setAttribute('data-state', isOpen ? 'open' : 'closed');
      const label = isOpen ? badge.getAttribute('data-label-open') : badge.getAttribute('data-label-closed');
      badge.innerHTML = `<span class="dot"></span><span>${label}</span>`;
    });
  });
</script>
